# Archiva backend configuration
# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored: never commit real credentials.

# PostgreSQL connection (SQLAlchemy async URL, asyncpg driver).
# Also read by create_db.py, migration.py and the other helper scripts.
# URL-encode special characters in the password (for example "@" becomes "%40").
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/archiva

# Secret used to sign JWT tokens. Use a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# JWT signing algorithm and token lifetime in minutes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: only used by the experimental scripts debug_ai.py, list_models.py
# and test_ai.py. The application itself does not need it.
GEMINI_API_KEY=your_gemini_api_key_here
